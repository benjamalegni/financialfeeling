name: Deploy on Push

on:
  push:
    branches:
      - main # This specifies that the workflow triggers on pushes to the 'main' branch

jobs:
  deploy:
    runs-on: ubuntu-latest # The type of runner that the job will run on

    steps:
      - name: Checkout code
        uses: actions/checkout@v4 # Checks out your repository code

      - name: Setup environment (e.g., Node.js, Python, etc.)
        # Example for Node.js:
        uses: actions/setup-node@v4
        with:
          node-version: '20' # Specify your desired Node.js version

      - name: Install dependencies
        run: npm install # Or 'pip install -r requirements.txt' for Python, etc.

      - name: Build application (if necessary)
        run: npm run build # Or your specific build command

      - name: Deploy to target environment
